[Unit]
Description=Royale print relay (website print queue -> bar TM-m30)
After=network-online.target
Wants=network-online.target

[Service]
# ID, password and printer address: see README.md. Readable by root only.
EnvironmentFile=/etc/rcl-print-relay.conf
ExecStart=/usr/bin/python3 /opt/rcl-print-relay/rcl_print_relay.py
Restart=always
RestartSec=5
# Runs as a throwaway user with no access to anything else on the Pi.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
