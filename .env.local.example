# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Bypasses Row Level Security. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode keys to start: https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook's signing secret in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=

# OMDb (https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# Menu pictures (optional). With these set, the register's picture finder asks
# Pixabay and Pexels first for big, sharp photos; without them it uses the
# free libraries that need no key. Server-side only, never NEXT_PUBLIC_.
# Apply supabase/migrations/20261001130000_menu_text_icons.sql first: until
# it runs, the finder leaves these two libraries out even with keys set.
# "Find pictures for everything" never asks Pixabay (its API is for people's
# own searches); it can use Pexels.
# Pixabay: https://pixabay.com/api/docs/ (sign in to see your key)
PIXABAY_API_KEY=
# Pexels: https://www.pexels.com/api/ (Your API key)
PEXELS_API_KEY=

# Base URL of this app, used for Stripe redirect/webhook URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Email (Resend: https://resend.com) ----------
# A "Sending access" API key is enough: our database decides who gets what,
# and Resend only delivers (no contacts, segments or broadcasts).
RESEND_API_KEY=
# The sender, at the domain verified in Resend (never @resend.dev for lists).
EMAIL_FROM="Royale Cinema Lounge <hello@royalecinemajoplin.com>"
# Where replies go (a person reads them).
EMAIL_REPLY_TO=info@royalecinemajoplin.com
# Signing secret of the Resend webhook (points at /api/resend/webhook).
RESEND_WEBHOOK_SECRET=
# Signs the unsubscribe and preference links in every email. 32+ random
# bytes (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
# Never rotate it casually: old emails' unsubscribe links stop working.
EMAIL_TOKEN_SECRET=
# The kill switch. Nothing goes to a list until this is exactly "true"
# (only after the go-live checklist passes).
EMAIL_SENDING_ENABLED=
# Optional: staff seed inboxes for test sends (Gmail, Yahoo, Outlook, iCloud), comma-separated.
EMAIL_SEED_LIST=
# Optional: how far ahead a cron run hands email to Resend with scheduled_at
# (hours, default 24; keep 24 on Vercel Hobby's once-a-day cron).
EMAIL_SCHEDULE_AHEAD_HOURS=
# Optional: who gets the daily report instead of the admins (comma-separated).
REPORT_TO=
# Vercel sends this to the cron routes; set it to lock them down. It also
# signs /api/email/recall, which carries on calling back a big list from
# Resend after "Stop all sending" or a guardrail (without it, the Email
# page's "Call back" button does that while it's open).
CRON_SECRET=
