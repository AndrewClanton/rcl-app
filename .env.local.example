# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Bypasses Row Level Security. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode keys to start: https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook's signing secret in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=

# OMDb (https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# Base URL of this app, used for Stripe redirect/webhook URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email through Resend (https://resend.com). A "Full access" API key: the
# mailing list needs contacts and broadcasts, not just sending.
RESEND_API_KEY=
# The sender, at the domain verified in Resend.
EMAIL_FROM="Royale Cinema Lounge <hello@royalecinemajoplin.com>"
# Signing secret of the Resend webhook (points at /api/resend/webhook).
RESEND_WEBHOOK_SECRET=
# Optional: the list's segment id. Left empty, the site finds or makes the
# segment "Royale Insiders (website)" itself.
RESEND_SEGMENT_ID=
# Optional: who gets the daily report instead of the admins (comma-separated).
REPORT_TO=
# Optional: Vercel sends this to the cron routes; set it to lock them down.
CRON_SECRET=
