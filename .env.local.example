# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Bypasses Row Level Security. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode keys to start: https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook's signing secret in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=

# TMDb (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Base URL of this app, used for Stripe redirect/webhook URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
